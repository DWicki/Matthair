<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher glyph: a smart-home house (with a small device network inside) above a
  three-sided "connect" mark that nods to Matter's triangle. Original artwork, not the
  Home Assistant or Matter logos (both are trademarks of their owners).
  Everything stays inside the adaptive-icon safe zone (circle of 66dp centred at 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- House: roof and walls -->
    <path
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,47 L54,28 L76,47 M38,42 L38,66 L70,66 L70,42" />

    <!-- Device network inside the house -->
    <path
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,66 L54,43 M54,57 L46,51 M54,52 L62,47" />
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M54,39 a3.6,3.6 0 1,1 0,7.2 a3.6,3.6 0 1,1 0,-7.2 Z M46,47.4 a3.6,3.6 0 1,1 0,7.2 a3.6,3.6 0 1,1 0,-7.2 Z M62,43.4 a3.6,3.6 0 1,1 0,7.2 a3.6,3.6 0 1,1 0,-7.2 Z" />

    <!-- Connect mark below: open triangle of three sides -->
    <path
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M52.2,74.4 L46.6,83.0 M55.8,74.4 L61.4,83.0 M49.4,86 L58.6,86" />
</vector>
